name: Sync Upstream

on:
  schedule:
    - cron: "0 6 * * 1,4" # Mon and Thu at 06:00 UTC
  workflow_dispatch:

jobs:
  sync:
    if: github.repository != 'anomalyco/opencode'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
    steps:
      - uses: actions/checkout@v4
        with:
          ref: patches
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Fetch upstream
        run: |
          git remote add upstream https://github.com/anomalyco/opencode.git
          git fetch upstream dev

      - name: Check for new commits
        id: check
        run: |
          BEHIND=$(git rev-list --count patches..upstream/dev)
          echo "behind=$BEHIND" >> $GITHUB_OUTPUT
          echo "Upstream has $BEHIND new commit(s)"

      - name: Check patched files
        if: steps.check.outputs.behind != '0'
        run: |
          LAST_SYNCED=$(git merge-base patches upstream/dev)
          CHANGED=$(git diff --name-only $LAST_SYNCED upstream/dev)
          PATCHED_FILES=(
            "packages/opencode/src/cli/cmd/tui/context/sync.tsx"
            "packages/opencode/src/cli/cmd/tui/routes/session/index.tsx"
            "packages/opencode/src/cli/cmd/tui/component/prompt/index.tsx"
            "packages/opencode/src/session/index.ts"
            "packages/opencode/src/session/message-v2.ts"
            "packages/opencode/test/session/messages-pagination.test.ts"
          )
          echo "=== Conflict risk check ==="
          for f in "${PATCHED_FILES[@]}"; do
            if echo "$CHANGED" | grep -q "$f"; then
              echo "WARNING: $f changed upstream"
            fi
          done

      - name: Attempt rebase
        if: steps.check.outputs.behind != '0'
        id: rebase
        continue-on-error: true
        run: |
          git rebase upstream/dev 2>&1 | tee /tmp/rebase.log
          echo "status=success" >> $GITHUB_OUTPUT

      - name: Push rebased branches
        if: steps.rebase.outputs.status == 'success'
        run: |
          git push origin patches --force-with-lease
          git checkout dev
          git reset --hard patches
          git push origin dev --force-with-lease
          git format-patch -3 -o patches/custom/

      - name: Create issue on conflict
        if: steps.check.outputs.behind != '0' && steps.rebase.outputs.status != 'success'
        run: |
          git rebase --abort || true
          BODY=$(cat /tmp/rebase.log 2>/dev/null || echo "Rebase failed - check logs")
          gh issue create \
            --title "Upstream sync conflict - manual rebase needed" \
            --body "$(printf '## Rebase failed\n\nUpstream has new commits that conflict with our patches.\n\n```\n%s\n```\n\n### Manual resolution\n```bash\ngit fetch upstream\ngit checkout patches\ngit rebase upstream/dev\n# resolve conflicts\ngit rebase --continue\ngit checkout dev && git reset --hard patches\ngit push origin patches dev --force-with-lease\n```' "$BODY")" \
            --label "upstream-sync"
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
