#!/bin/sh
# Notify only — never auto-modify the working tree.
#
# Runs after a `git pull` or `git merge`. If the upstream remote exists and has
# new commits since HEAD, print a one-shot reminder. Silent otherwise.
#
# The scheduled CI workflow (Mon/Thu 06:00 UTC) handles actual syncing; this
# hook just surfaces "there's something to sync" to the developer.

if ! git remote | grep -q '^upstream$'; then
  exit 0
fi

git fetch --quiet upstream dev >/dev/null 2>&1 || exit 0

BEHIND=$(git rev-list --count HEAD..upstream/dev 2>/dev/null || echo 0)

if [ "$BEHIND" -gt 0 ]; then
  printf '\n'
  printf '[opencode fork] upstream has %s new commit(s) since HEAD\n' "$BEHIND"
  printf '  CI will sync on next Mon/Thu 06:00 UTC, or trigger manually:\n'
  printf '    gh workflow run sync-upstream-v2.yml\n'
  printf '\n'
fi

exit 0
